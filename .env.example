# ---- Servidor BI (PostgreSQL, somente leitura) ----
# Em hospedagem, DATABASE_URL tem prioridade sobre os campos BI_*.
DATABASE_URL=
BI_HOST=seu-servidor-postgres
BI_PORT=5432
BI_DATABASE=seu_banco
BI_USER=seu_usuario
BI_PASSWORD=

# ---- Servidor BI 2 (transferencia de arquivos) ----
BI2_HOST=seu-servidor-sftp
BI2_USER=seu_usuario_sftp
BI2_PASSWORD=
# sftp | ftp | ftps  (deixe em auto para tentar todos)
BI2_PROTOCOL=auto
BI2_PORT=22

# ---- Chat em linguagem natural (opcional) ----
# Sem a chave, o chat continua atendendo perguntas operacionais comuns.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Aplicacao ----
API_HOST=127.0.0.1
API_PORT=8000
QUERY_TIMEOUT_MS=20000

# ---- Acesso ao dashboard ----
DASHBOARD_USER=ativa
DASHBOARD_PASSWORD=
DASHBOARD_AUTH_SECRET=
DASHBOARD_SESSION_HOURS=12
DASHBOARD_COOKIE_SECURE=false
